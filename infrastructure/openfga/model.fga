model
  schema 1.1

type user

type developer
  relations
    define admin: [user]
    define self: [user]

type project
  relations
    define owner: [developer]
    define assigned_cp: [user]

    define can_view: assigned_cp
      or self from owner
      or admin from owner

    define can_edit: self from owner
      or admin from owner

    define can_delete: self from owner
      or admin from owner